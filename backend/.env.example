PORT=5000
# Local MongoDB (provided by docker-compose.yml)
MONGO_URI=mongodb://127.0.0.1:27017/fabrinova3d
# For MongoDB Atlas, replace MONGO_URI with:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fabrinova3d?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
# Required only once to create the first administrator at /admin/signup.
# Use a long private value that is different from JWT_SECRET.
ADMIN_SETUP_KEY=replace_with_a_second_long_random_secret
CLIENT_URL=http://localhost:5173

# Mailer (used to notify staff on new quote/contact submissions)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
MAIL_TO=contact@fabrinova3d.com
